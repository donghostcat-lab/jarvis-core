# Jarvis Job: example. Copy to .env; never commit .env.
JARVIS_PROFILE=job
# Model access through the company contract (only for approved data):
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
# Local model (OpenAI-compatible, e.g. Ollama or MLX on your own machine):
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
JARVIS_DATA_DIR=./data
JARVIS_TIMEZONE=Europe/Berlin
