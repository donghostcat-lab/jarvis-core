# Jarvis Job – Beispiel. Kopieren nach .env; .env nie committen.
JARVIS_PROFIL=job
# Modellzugang über den Firmenvertrag (nur für freigegebene Daten):
ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-5-5
# Lokales Modell (OpenAI-kompatibel, z. B. Ollama oder MLX auf einem eigenen Rechner):
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
JARVIS_DATA_DIR=./data
JARVIS_TIMEZONE=Europe/Berlin
